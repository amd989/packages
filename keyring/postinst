#!/bin/sh
set -e

SOURCES=/etc/apt/sources.list.d/alejandro-md.sources
KEYRING=/usr/share/keyrings/alejandro-md.gpg

case "$1" in
  configure)
    CODENAME=""
    if [ -r /etc/os-release ]; then
      CODENAME="$(. /etc/os-release 2>/dev/null; printf '%s' "${VERSION_CODENAME:-}")"
    fi
    if [ -z "$CODENAME" ] && command -v lsb_release >/dev/null 2>&1; then
      CODENAME="$(lsb_release -cs 2>/dev/null || true)"
    fi

    case "$CODENAME" in
      bookworm|trixie)
        SUITE="$CODENAME"
        ;;
      *)
        SUITE="bookworm"
        echo "alejandro-md-keyring: no packages are built for '${CODENAME:-unknown}';" >&2
        echo "alejandro-md-keyring: registering the bookworm suite, which may not be installable here." >&2
        ;;
    esac

    # Every architecture this machine installs packages for, native or foreign,
    # that the repository also builds. Listing only the native one would cut
    # off multiarch installs: a 64-bit Pi running the armhf build (the old
    # setup script's --prefer-armhf) would never see the armhf index again.
    # Foreign architectures the repository does not build, such as i386,
    # are left out so apt does not report skipping them on every update.
    ARCHES=""
    for a in $(dpkg --print-architecture) $(dpkg --print-foreign-architectures); do
      case "$a" in
        amd64|arm64|armhf|armel) ARCHES="$ARCHES $a" ;;
      esac
    done
    ARCHES="${ARCHES# }"
    [ -n "$ARCHES" ] || ARCHES="$(dpkg --print-architecture)"

    cat > "$SOURCES" <<EOF
# Managed by alejandro-md-keyring. Local edits are overwritten on upgrade.
Types: deb
URIs: https://packages.alejandro.md/deb
Suites: $SUITE
Components: main
Architectures: $ARCHES
Signed-By: $KEYRING
EOF
    chmod 0644 "$SOURCES"

    # Retire the per-project source files from before the move to
    # packages.alejandro.md, so apt does not report duplicate or dead sources.
    for legacy in mariner3d mariner lcd4linux-ax206 mediasmartserverd \
                  mediasmartserver unifi-gateway infrafi infrafid; do
      for ext in list sources; do
        old="/etc/apt/sources.list.d/${legacy}.${ext}"
        if [ -f "$old" ] && grep -qE 'amd989\.github\.io|ppa\.l9o\.dev' "$old" 2>/dev/null; then
          mv "$old" "${old}.replaced-by-alejandro-md-keyring"
          echo "alejandro-md-keyring: retired stale source $old" >&2
        fi
      done
    done

    # The old channels each installed their own keyring under a project
    # name. They are harmless once the source is gone, but leaving them
    # suggests a repository that no longer exists.
    for legacy in mariner3d mariner lcd4linux-ax206 mediasmartserverd \
                  mediasmartserver unifi-gateway infrafi infrafid; do
      rm -f "/usr/share/keyrings/${legacy}.gpg"
    done
    ;;
esac


exit 0
